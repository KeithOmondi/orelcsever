{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=4096 --expose-gc dist/server.js",
    "dev": "tsx watch --max-old-space-size=4096 src/server.ts",
    "dev:debug": "nodemon --watch src --ext ts --exec \"node --max-old-space-size=4096 --expose-gc --inspect -r @swc-node/register src/server.ts\"",
    "test:imports": "node --max-old-space-size=4096 --expose-gc -r ts-node/register src/test-imports.ts",
    "migrate": "ts-node src/config/migrate.ts",
    "postinstall": "node -e \"if (!process.env.RENDER) { require('child_process').execSync('npx puppeteer browsers install chrome', { stdio: 'inherit' }); }\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemon": "^3.1.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react-icons": "^5.7.0",
    "sooner": "^1.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
